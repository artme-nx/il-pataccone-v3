{
  "$schema": "https://design-tokens.org/schema.json",
  "primitive": {
    "color": {
      "ink": {
        "950": { "$value": "#14100C", "$type": "color" },
        "900": { "$value": "#1F1912", "$type": "color" },
        "800": { "$value": "#2E251A", "$type": "color" },
        "700": { "$value": "#473B29", "$type": "color" }
      },
      "stone": {
        "100": { "$value": "#F5EEDC", "$type": "color" },
        "300": { "$value": "#D9C89E", "$type": "color" },
        "500": { "$value": "#A89873", "$type": "color" }
      },
      "patina": {
        "300": { "$value": "#7EB0A3", "$type": "color" },
        "500": { "$value": "#3E8172", "$type": "color" },
        "700": { "$value": "#2A5D52", "$type": "color" },
        "900": { "$value": "#163430", "$type": "color" }
      }
    },
    "font": {
      "display": { "$value": "var(--font-newsreader), 'Newsreader', Georgia, serif", "$type": "fontFamily" },
      "sans": { "$value": "var(--font-work-sans), 'Work Sans', system-ui, sans-serif", "$type": "fontFamily" }
    },
    "motion": {
      "duration": {
        "micro": { "$value": "180ms", "$type": "duration" },
        "base": { "$value": "320ms", "$type": "duration" },
        "reveal": { "$value": "1.1s", "$type": "duration" },
        "cine": { "$value": "1.8s", "$type": "duration" }
      },
      "ease": {
        "out-expo": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" },
        "cine": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier" }
      }
    },
    "tracking": {
      "display": { "$value": "-0.01em", "$type": "dimension" },
      "label": { "$value": "0.26em", "$type": "dimension" }
    }
  },
  "semantic": {
    "background": { "$value": "{primitive.color.ink.950}", "$type": "color" },
    "foreground": { "$value": "{primitive.color.stone.100}", "$type": "color" },
    "card": { "$value": "{primitive.color.ink.900}", "$type": "color" },
    "card-foreground": { "$value": "{primitive.color.stone.100}", "$type": "color" },
    "muted": { "$value": "{primitive.color.ink.900}", "$type": "color" },
    "muted-foreground": { "$value": "{primitive.color.stone.500}", "$type": "color" },
    "accent": { "$value": "{primitive.color.ink.800}", "$type": "color" },
    "accent-foreground": { "$value": "{primitive.color.stone.100}", "$type": "color" },
    "border": { "$value": "{primitive.color.ink.700}", "$type": "color" },
    "ring": { "$value": "{primitive.color.patina.500}", "$type": "color" },
    "radius": { "$value": "0.85rem", "$type": "dimension" },
    "patina": { "$value": "{primitive.color.patina.500}", "$type": "color" },
    "patina-dim": { "$value": "{primitive.color.patina.900}", "$type": "color" },
    "surface-line": { "$value": "{primitive.color.ink.700}", "$type": "color" },
    "type-display": { "$value": "{primitive.font.display}", "$type": "fontFamily" },
    "type-body": { "$value": "{primitive.font.sans}", "$type": "fontFamily" },
    "ease-reveal": { "$value": "{primitive.motion.ease.out-expo}", "$type": "cubicBezier" },
    "ease-cine": { "$value": "{primitive.motion.ease.cine}", "$type": "cubicBezier" },
    "duration-micro": { "$value": "{primitive.motion.duration.micro}", "$type": "duration" },
    "duration-base": { "$value": "{primitive.motion.duration.base}", "$type": "duration" },
    "duration-reveal": { "$value": "{primitive.motion.duration.reveal}", "$type": "duration" },
    "tracking-display": { "$value": "{primitive.tracking.display}", "$type": "dimension" },
    "tracking-label": { "$value": "{primitive.tracking.label}", "$type": "dimension" }
  },
  "component": {
    "hero": {
      "title-size": { "$value": "clamp(2.7rem, 7.2vw, 6rem)", "$type": "dimension" },
      "title-leading": { "$value": "1.03", "$type": "number" },
      "glow": {
        "$value": "radial-gradient(ellipse 70% 50% at 50% 100%, rgba(62, 129, 114, 0.24), rgba(22, 52, 48, 0.1) 45%, transparent 72%)",
        "$type": "gradient"
      },
      "vignette": {
        "$value": "linear-gradient(to top, rgba(20, 16, 12, 0.95) 0%, rgba(20, 16, 12, 0.3) 42%, rgba(20, 16, 12, 0.55) 100%)",
        "$type": "gradient"
      }
    },
    "button": {
      "primary-bg": { "$value": "{primitive.color.patina.500}", "$type": "color" },
      "primary-fg": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "primary-hover-bg": { "$value": "{primitive.color.stone.100}", "$type": "color" },
      "ghost-border": { "$value": "rgba(245, 238, 220, 0.32)", "$type": "color" },
      "ghost-hover-border": { "$value": "{primitive.color.patina.500}", "$type": "color" }
    }
  }
}
